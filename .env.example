# =============================================================================
# ClassroomIQ — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit `.env` to version control (it is in .gitignore).
#
# Usage:
#   cp .env.example .env
# =============================================================================

# ── Database Connection ───────────────────────────────────────────────────────
#
# Full format:
#   postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
#
# Parameter breakdown:
#   postgresql+psycopg2  → dialect+driver. "postgresql" = PostgreSQL database,
#                          "+psycopg2" = use the psycopg2 Python driver.
#                          Alternative drivers: asyncpg (async), pg8000 (pure Python).
#
#   username             → PostgreSQL login role. Default is "postgres".
#                          In production, use a dedicated low-privilege role.
#
#   password             → The password for the above PostgreSQL role.
#                          URL-encode special chars: @ → %40, # → %23, : → %3A
#
#   host                 → Where PostgreSQL is running.
#                          "localhost" = same machine.
#                          In Docker Compose: use the service name (e.g. "db").
#
#   port                 → PostgreSQL listens on 5432 by default.
#                          Change only if you have a custom pg_hba.conf or Docker mapping.
#
#   database_name        → The specific database inside PostgreSQL.
#                          Create it first: `CREATE DATABASE classroomiq_db;`
#
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/classroomiq_db

# ── Application Settings (add as needed) ─────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI / LLM Keys (add as needed) ────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# ── Storage (add as needed) ───────────────────────────────────────────────────
# MEDIA_ROOT=./uploads
